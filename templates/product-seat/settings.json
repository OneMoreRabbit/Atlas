       "hooks": [{"type": "command", "command": "sh \"$CLAUDE_PROJECT_DIR/atlas-product-guard.sh\""}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "sh \"$CLAUDE_PROJECT_DIR/atlas-product-align.sh\""}]}
    ]
  }
}
